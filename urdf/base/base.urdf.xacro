<?xml version="1.0"?>
<robot name="base" xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:macro name="base" params="prefix">

        <!-- Robot mechanical and motor parameters -->
        <xacro:property name="PI" value="3.1415926535897931"/>
        
        <!-- BASE LINK -->
        <link name="${prefix}base_link">
            <!-- PCB (8 g, real outline), ESP S2 mini (2.4 g), GY-87 (3 g),
                 battery 300 mAh under the PCB (6 g), PCB components (3 g) and
                 the 4 motors without propeller (4 x 1.5 g). Positions from
                 the KiCad PCB and final_drone.dae. Total drone: 29 g -->
            <inertial>
                <origin xyz="-0.00036 0.00005 0.00059" rpy="0 0 0"/>
                <mass value="0.0284"/>
                <inertia  ixx="1.474e-05" ixy="2.5e-08"  ixz="-1.33e-07"  iyy="1.591e-05"  iyz="0.0"  izz="2.932e-05" />
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find sim_drone)/meshes/dae/final_drone.dae"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="file://$(find sim_drone)/meshes/dae/final_drone.dae"/>
                </geometry>
            </collision>
        </link>

        <gazebo>
            <plugin filename="gz-sim-odometry-publisher-system"
                name="gz::sim::systems::OdometryPublisher">
            <odom_frame>odom_gt</odom_frame>
            <robot_base_frame>${prefix}base_link</robot_base_frame>
            </plugin>
        </gazebo>

    </xacro:macro>
</robot>